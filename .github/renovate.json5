{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  dependencyDashboard: {
    enabled: true,
  },
  suppressNotifications: [
    'prEditedNotification',
  ],
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigestsToSemver',
    'replacements:all',
    'abandonments:recommended',
  ],
  configMigration: true,
  labels: [
    'bot: dependencies',
  ],
  rebaseLabel: 'bot: rebase',
  semanticCommits: 'disabled',
  separateMajorMinor: false,
  prHourlyLimit: 10,
  ignoreDeps: [
    'python',
  ],
  'pre-commit': {
    enabled: true,
  },
  minimumReleaseAge: '7 days',
  packageRules: [
    {
      matchUpdateTypes: [
        'pinDigest',
      ],
      minimumReleaseAge: null,
    },
    {
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      description: 'Quarterly update of GitHub Action dependencies',
      schedule: [
        'every 3 months on the first day of the month',
      ],
    },
    {
      groupName: 'most test/lint dependencies',
      matchManagers: [
        'pip_requirements',
        'pre-commit',
      ],
      description: 'Quarterly update of most test dependencies',
      schedule: [
        'every 3 months on the first day of the month',
      ],
    },
    {
      groupName: 'ruff',
      matchManagers: [
        'pip_requirements',
        'pre-commit',
      ],
      matchPackageNames: [
        'ruff',
        'astral-sh/ruff-pre-commit',
      ],
      description: 'Quarterly update of Ruff',
      schedule: [
        'every 3 months on the first day of the month',
      ],
    },
    {
      groupName: 'ty',
      matchManagers: [
        'pip_requirements',
      ],
      matchPackageNames: [
        'ty',
      ],
      description: 'Daily update of ty',
      schedule: [
        'before 4am',
      ],
    },
    {
      groupName: 'pyrefly',
      matchManagers: [
        'pip_requirements',
      ],
      matchPackageNames: [
        'pyrefly',
      ],
      description: 'Daily update of pyrefly',
      schedule: [
        'before 4am',
      ],
    },
    {
      groupName: 'mypy',
      matchManagers: [
        'pip_requirements',
      ],
      matchPackageNames: [
        'mypy',
      ],
      description: 'Daily update of mypy',
      schedule: [
        'before 4am',
      ],
    },
    {
      groupName: 'pyright',
      matchManagers: [
        'pip_requirements',
      ],
      matchPackageNames: [
        'pyright',
      ],
      description: 'Daily update of pyright',
      schedule: [
        'before 4am',
      ],
    },
  ],
}
