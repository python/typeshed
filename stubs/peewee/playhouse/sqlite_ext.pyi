from collections.abc import Callable
from typing import Any

from peewee import Expression, TextField

class JSONField(TextField[str]):
    def __init__(
        self, json_dumps: Callable[[Any], str] | None = ..., json_loads: Callable[[str], Any] | None = ..., **kwargs: Any
    ) -> None: ...
    def db_value(self, value: Any) -> str | None: ...
    def python_value(self, value: str | None) -> Any: ...
    def children(self) -> Expression: ...
    def length(self, path: str | None = None) -> Expression: ...
    def json_type(self) -> Expression: ...
