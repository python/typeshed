from _typeshed import FloatInt
from collections.abc import Collection
from typing import Literal, TypeAlias, overload

from ._typing import GeoT
from .geometry import Point
from .lib import Geometry

__all__ = ["affine_transform", "rotate", "scale", "skew", "translate"]

_Origin: TypeAlias = Literal["center", "centroid"] | Point | tuple[FloatInt, FloatInt] | tuple[FloatInt, FloatInt, FloatInt]

def affine_transform(geom: GeoT, matrix: Collection[FloatInt]) -> GeoT: ...

@overload
def interpret_origin(geom: Geometry, origin: _Origin, ndim: Literal[2]) -> tuple[float, float]: ...
@overload
def interpret_origin(geom: Geometry, origin: _Origin, ndim: Literal[3]) -> tuple[float, float, float]: ...
@overload
def interpret_origin(geom: Geometry, origin: _Origin, ndim: int) -> tuple[float, float] | tuple[float, float, float]: ...

def rotate(geom: GeoT, angle: FloatInt, origin: _Origin = "center", use_radians: bool = False) -> GeoT: ...
def scale(geom: GeoT, xfact: FloatInt = 1.0, yfact: FloatInt = 1.0, zfact: FloatInt = 1.0, origin: _Origin = "center") -> GeoT: ...
def skew(geom: GeoT, xs: FloatInt = 0.0, ys: FloatInt = 0.0, origin: _Origin = "center", use_radians: bool = False) -> GeoT: ...
def translate(geom: GeoT, xoff: FloatInt = 0.0, yoff: FloatInt = 0.0, zoff: FloatInt = 0.0) -> GeoT: ...
