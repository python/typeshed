from collections.abc import Iterator, Mapping, MutableMapping as MutableMappingType
from typing import Any, TypeVar
from typing_extensions import Self

from ldap.pkginfo import __version__ as __version__

_T = TypeVar("_T", bound=Any)

class cidict(MutableMappingType[str, _T]):
    _keys: dict[str, str]
    _data: dict[str, _T]
    def __init__(self, default: Mapping[str, _T] | None = None) -> None: ...
    def __getitem__(self, key: str) -> _T: ...
    def __setitem__(self, key: str, value: _T) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object) -> bool: ...
    def clear(self) -> None: ...
    def copy(self) -> Self: ...
    __copy__ = copy
    def has_key(self, key: str) -> bool: ...
    @property
    def data(self) -> dict[str, _T]: ...

def strlist_minus(a: list[str], b: list[str]) -> list[str]: ...
def strlist_intersection(a: list[str], b: list[str]) -> list[str]: ...
def strlist_union(a: list[str], b: list[str]) -> list[str]: ...
