from collections.abc import Iterable
from typing import ClassVar, Final, overload

from .main import _YAMLObject

merge_attrib: Final = "_yaml_merge"

class MergeValue:
    attrib: ClassVar[str]
    value: list[_YAMLObject]
    sequence: _YAMLObject | None
    merge_pos: int | None
    def __init__(self) -> None: ...

    @overload
    def __getitem__(self, index: int, /) -> _YAMLObject: ...
    @overload
    def __getitem__(self, index: slice, /) -> list[_YAMLObject]: ...

    @overload
    def __setitem__(self, index: int, val: _YAMLObject, /) -> None: ...
    @overload
    def __setitem__(self, index: slice, val: Iterable[_YAMLObject], /) -> None: ...

    def __len__(self) -> int: ...
    def append(self, elem: _YAMLObject, /) -> None: ...
    def extend(self, elements: Iterable[_YAMLObject], /) -> None: ...
    def set_sequence(self, seq: _YAMLObject, /) -> None: ...
