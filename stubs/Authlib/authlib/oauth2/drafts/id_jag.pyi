from logging import Logger
from typing import ClassVar

from authlib.oauth2.rfc6749 import BaseGrant, TokenEndpointMixin
from authlib.oauth2.rfc7523.jwt_bearer import JWT_BEARER_GRANT_TYPE

log: Logger

class IDJAGGrant(BaseGrant, TokenEndpointMixin):
    GRANT_TYPE = JWT_BEARER_GRANT_TYPE
    REQUIRED_TYP: ClassVar[str]
    CLAIMS_OPTIONS: ClassVar[dict[str, dict[str, bool]]]
    LEEWAY: ClassVar[int]
    @staticmethod
    def sign(key, issuer, audience, subject, client_id, jti=None, issued_at=None, expires_at=None, claims=None, **kwargs): ...
    def validate_token_request(self) -> None: ...
    def create_token_response(self): ...
    def get_audiences(self) -> list[str]: ...
    # Returns a joserfc.jwk.Key or joserfc.jwk.KeySet
    def resolve_issuer_key(self, issuer, headers): ...
    def authenticate_user(self, subject): ...
    def check_jti(self, claims, jti) -> bool: ...
    def check_id_jag_permission(self, client, user, scopes) -> bool: ...
