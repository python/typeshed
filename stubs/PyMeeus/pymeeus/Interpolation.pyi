from _typeshed import FloatInt
from typing import overload

from pymeeus.Angle import Angle

class Interpolation:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, a: Interpolation, /) -> None: ...
    @overload
    def __init__(self, a: list[FloatInt | Angle] | tuple[FloatInt | Angle, ...], /) -> None: ...
    @overload
    def __init__(
        self,
        a1: list[FloatInt | Angle] | tuple[FloatInt | Angle, ...],
        a2: list[FloatInt | Angle] | tuple[FloatInt | Angle, ...],
        /,
    ) -> None: ...
    @overload
    def __init__(
        self, a1: FloatInt | Angle, a2: FloatInt | Angle, a3: FloatInt | Angle, a4: FloatInt | Angle, /, *rest: FloatInt | Angle
    ) -> None: ...

    @overload
    def set(self) -> None: ...
    @overload
    def set(self, a: Interpolation, /) -> None: ...
    @overload
    def set(self, a: list[FloatInt | Angle] | tuple[FloatInt | Angle, ...], /) -> None: ...
    @overload
    def set(
        self,
        a1: list[FloatInt | Angle] | tuple[FloatInt | Angle, ...],
        a2: list[FloatInt | Angle] | tuple[FloatInt | Angle, ...],
        /,
    ) -> None: ...
    @overload
    def set(
        self, a1: FloatInt | Angle, a2: FloatInt | Angle, a3: FloatInt | Angle, a4: FloatInt | Angle, /, *rest: FloatInt | Angle
    ) -> None: ...

    def __len__(self) -> int: ...
    def get_tolerance(self) -> float: ...
    def set_tolerance(self, tol: FloatInt) -> None: ...
    def __call__(self, x: FloatInt | Angle) -> float | Angle: ...
    def derivative(self, x: FloatInt | Angle) -> float: ...
    def root(self, xl: FloatInt | Angle = 0, xh: FloatInt | Angle = 0, max_iter: int = 1000) -> float | Angle: ...
    def minmax(self, xl: FloatInt | Angle = 0, xh: FloatInt | Angle = 0, max_iter: int = 1000) -> float | Angle: ...

def main() -> None: ...
