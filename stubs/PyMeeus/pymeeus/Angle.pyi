from _typeshed import FloatInt
from typing import overload
from typing_extensions import Self

class Angle:
    @overload
    def __init__(self, *, ra: bool = False) -> None: ...
    @overload
    def __init__(self, a: Angle, /, *, ra: bool = False) -> None: ...
    @overload
    def __init__(self, a: FloatInt, /, *, ra: bool = False, radians: bool = False) -> None: ...
    @overload
    def __init__(self, a: list[FloatInt] | tuple[FloatInt, ...], /, *, ra: bool = False, radians: bool = False) -> None: ...
    @overload
    def __init__(self, a1: FloatInt, a2: FloatInt, /, *, ra: bool = False) -> None: ...
    @overload
    def __init__(self, a1: FloatInt, a2: FloatInt, a3: FloatInt, /, *, ra: bool = False) -> None: ...
    @overload
    def __init__(self, a1: FloatInt, a2: FloatInt, a3: FloatInt, a4: FloatInt, /, *, ra: bool = False) -> None: ...

    @staticmethod
    def reduce_deg(deg: FloatInt | Angle) -> float: ...
    @staticmethod
    def reduce_dms(degrees: FloatInt, minutes: FloatInt, seconds: FloatInt = 0.0) -> tuple[int, int, float, float]: ...
    @staticmethod
    def deg2dms(deg: FloatInt | Angle) -> tuple[int, int, float, float]: ...
    @staticmethod
    def dms2deg(degrees: FloatInt, minutes: FloatInt, seconds: FloatInt = 0.0) -> float: ...
    def get_tolerance(self) -> float: ...
    def set_tolerance(self, tol: FloatInt) -> None: ...
    def __call__(self) -> float: ...

    @overload
    def set(self, *, ra: bool = False) -> None: ...
    @overload
    def set(self, a: Angle, /, *, ra: bool = False) -> None: ...
    @overload
    def set(self, a: FloatInt, /, *, ra: bool = False, radians: bool = False) -> None: ...
    @overload
    def set(self, a: list[FloatInt] | tuple[FloatInt, ...], /, *, ra: bool = False, radians: bool = False) -> None: ...
    @overload
    def set(self, a1: FloatInt, a2: FloatInt, /, *, ra: bool = False) -> None: ...
    @overload
    def set(self, a1: FloatInt, a2: FloatInt, a3: FloatInt, /, *, ra: bool = False) -> None: ...
    @overload
    def set(self, a1: FloatInt, a2: FloatInt, a3: FloatInt, a4: FloatInt, /, *, ra: bool = False) -> None: ...

    def set_radians(self, rads: FloatInt) -> None: ...

    @overload
    def set_ra(self) -> None: ...
    @overload
    def set_ra(self, a: FloatInt | Angle | list[FloatInt] | tuple[FloatInt, ...], /) -> None: ...
    @overload
    def set_ra(self, a1: FloatInt, a2: FloatInt, /) -> None: ...
    @overload
    def set_ra(self, a1: FloatInt, a2: FloatInt, a3: FloatInt, /) -> None: ...
    @overload
    def set_ra(self, a1: FloatInt, a2: FloatInt, a3: FloatInt, a4: FloatInt, /) -> None: ...

    def dms_str(self, fancy: bool | None = True, n_dec: int = -1) -> str: ...
    def get_ra(self) -> float: ...
    def ra_str(self, fancy: bool | None = True, n_dec: int = -1) -> str: ...
    def rad(self) -> float: ...
    def dms_tuple(self) -> tuple[int, int, float, float]: ...
    def ra_tuple(self) -> tuple[int, int, float, float]: ...
    def to_positive(self) -> Self: ...
    def __eq__(self, b: FloatInt | Angle) -> bool: ...  # type: ignore[override]
    def __ne__(self, b: FloatInt | Angle) -> bool: ...  # type: ignore[override]
    def __lt__(self, b: FloatInt | Angle) -> bool: ...
    def __ge__(self, b: FloatInt | Angle) -> bool: ...
    def __gt__(self, b: FloatInt | Angle) -> bool: ...
    def __le__(self, b: FloatInt | Angle) -> bool: ...
    def __neg__(self) -> Angle: ...
    def __abs__(self) -> Angle: ...
    def __mod__(self, b: FloatInt | Angle) -> Angle: ...
    def __add__(self, b: FloatInt | Angle) -> Angle: ...
    def __sub__(self, b: FloatInt | Angle) -> Angle: ...
    def __mul__(self, b: FloatInt | Angle) -> Angle: ...
    def __div__(self, b: FloatInt | Angle) -> Angle: ...
    def __truediv__(self, b: FloatInt | Angle) -> Angle: ...
    def __pow__(self, b: FloatInt | Angle) -> Angle: ...
    def __imod__(self, b: FloatInt | Angle) -> Self: ...
    def __iadd__(self, b: FloatInt | Angle) -> Self: ...
    def __isub__(self, b: FloatInt | Angle) -> Self: ...
    def __imul__(self, b: FloatInt | Angle) -> Self: ...
    def __idiv__(self, b: FloatInt | Angle) -> Angle: ...
    def __itruediv__(self, b: FloatInt | Angle) -> Self: ...
    def __ipow__(self, b: FloatInt | Angle) -> Self: ...
    def __rmod__(self, b: FloatInt | Angle) -> Angle: ...
    def __radd__(self, b: FloatInt | Angle) -> Angle: ...
    def __rsub__(self, b: FloatInt | Angle) -> Angle: ...
    def __rmul__(self, b: FloatInt | Angle) -> Angle: ...
    def __rdiv__(self, b: FloatInt | Angle) -> Angle: ...
    def __rtruediv__(self, b: FloatInt | Angle) -> Angle: ...
    def __rpow__(self, b: FloatInt | Angle) -> Angle: ...
    def __float__(self) -> float: ...
    def __int__(self) -> int: ...
    def __round__(self, n: FloatInt = 0) -> Angle: ...

def main() -> None: ...
