from collections.abc import Callable, Generator, Iterable, Sequence
from re import Pattern
from typing import Any, TypeAlias, TypeVar

_Element: TypeAlias = Any  # lxml.etree._Element
_ElementTree: TypeAlias = Any  # lxml.etree._ElementTree
_T1 = TypeVar("_T1")
_T2 = TypeVar("_T2")

RESERVED_NS: Pattern[str]

def post_order_traverse(node: _Element) -> Generator[_Element]: ...
def reverse_post_order_traverse(node: _Element) -> Generator[_Element]: ...
def breadth_first_traverse(node: _Element) -> Generator[_Element]: ...
def longest_common_subsequence(
    left_sequence: Sequence[_T1], right_sequence: Sequence[_T2], eqfn: Callable[[_T1, _T2], bool] = ...
) -> Iterable[tuple[int, int]]: ...

WHITESPACE: Pattern[str]

def cleanup_whitespace(text: str) -> str: ...
def getpath(element: _Element, tree: _ElementTree | None = None) -> str: ...
def make_ascii_tree(element: _Element) -> str: ...
