from collections.abc import Iterable, Sequence
from re import Pattern
from typing import TypeAlias, overload

_Diff: TypeAlias = tuple[int, str]

class diff_match_patch:
    Diff_Timeout: float
    Diff_EditCost: int
    Match_Threshold: float
    Match_Distance: int
    Patch_DeleteThreshold: float
    Patch_Margin: int
    Match_MaxBits: int
    def __init__(self) -> None: ...
    DIFF_DELETE: int
    DIFF_INSERT: int
    DIFF_EQUAL: int
    DIFF_REPLACE: int
    def diff_main(self, text1: str, text2: str, checklines: bool = True, deadline: float | None = None) -> list[_Diff]: ...
    def diff_compute(self, text1: str, text2: str, checklines: bool, deadline: float) -> list[_Diff]: ...
    def diff_lineMode(self, text1: str, text2: str, deadline: float) -> list[_Diff]: ...
    def diff_bisect(self, text1: str, text2: str, deadline: float) -> list[_Diff]: ...
    def diff_bisectSplit(self, text1: str, text2: str, x: int, y: int, deadline: float) -> list[_Diff]: ...
    def diff_linesToChars(self, text1: str, text2: str) -> tuple[str, str, list[str]]: ...
    def diff_charsToLines(self, diffs: list[_Diff], lineArray: Sequence[str]) -> None: ...
    def diff_commonPrefix(self, text1: str, text2: str) -> int: ...
    def diff_commonSuffix(self, text1: str, text2: str) -> int: ...
    def diff_commonOverlap(self, text1: str, text2: str) -> int: ...
    def diff_halfMatch(self, text1: str, text2: str) -> tuple[str, str, str, str, str] | None: ...
    def diff_cleanupSemantic(self, diffs: list[_Diff]) -> None: ...
    def diff_cleanupSemanticLossless(self, diffs: list[_Diff]) -> None: ...
    BLANKLINEEND: Pattern[str]
    BLANKLINESTART: Pattern[str]
    def diff_cleanupEfficiency(self, diffs: list[_Diff]) -> None: ...
    def diff_cleanupMerge(self, diffs: list[_Diff]) -> None: ...
    def diff_xIndex(self, diffs: Sequence[_Diff], loc: int) -> int: ...
    def diff_prettyHtml(self, diffs: Sequence[_Diff]) -> str: ...
    def diff_text1(self, diffs: Sequence[_Diff]) -> str: ...
    def diff_text2(self, diffs: Sequence[_Diff]) -> str: ...
    def diff_levenshtein(self, diffs: Sequence[_Diff]) -> int: ...
    def diff_toDelta(self, diffs: Sequence[_Diff]) -> str: ...
    def diff_fromDelta(self, text1: str, delta: str) -> list[_Diff]: ...
    def match_main(self, text: str, pattern: str, loc: int) -> int: ...
    def match_bitap(self, text: str, pattern: str, loc: int) -> int: ...
    def match_alphabet(self, pattern: str) -> dict[str, int]: ...
    def patch_addContext(self, patch: patch_obj, text: str) -> None: ...

    @overload
    def patch_make(self, a: str, b: str, c: None = None) -> list[patch_obj]: ...
    @overload
    def patch_make(self, a: list[_Diff], b: None = None, c: None = None) -> list[patch_obj]: ...
    @overload
    def patch_make(self, a: str, b: list[_Diff], c: None = None) -> list[patch_obj]: ...
    @overload
    def patch_make(self, a: str, b: str, c: list[_Diff]) -> list[patch_obj]: ...

    def patch_deepCopy(self, patches: Iterable[patch_obj]) -> list[patch_obj]: ...
    def patch_apply(self, patches: Iterable[patch_obj], text: str) -> tuple[str, list[bool]]: ...
    def patch_addPadding(self, patches: Sequence[patch_obj]) -> str: ...
    def patch_splitMax(self, patches: list[patch_obj]) -> None: ...
    def patch_toText(self, patches: Iterable[patch_obj]) -> str: ...
    def patch_fromText(self, textline: str) -> list[patch_obj]: ...

class patch_obj:
    diffs: list[_Diff]
    start1: int | None
    start2: int | None
    length1: int
    length2: int
    def __init__(self) -> None: ...
