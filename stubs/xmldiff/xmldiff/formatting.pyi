from collections.abc import Generator, Iterable, Mapping
from typing import Any, Final, NamedTuple, TypeAlias

from xmldiff.actions import _Action
from xmldiff.diff import Differ

_Element: TypeAlias = Any  # lxml.etree._Element

DIFF_NS: Final[str]
DIFF_PREFIX: Final[str]
INSERT_NAME: Final[str]
DELETE_NAME: Final[str]
REPLACE_NAME: Final[str]
RENAME_NAME: Final[str]
WS_BOTH: Final[int]
WS_TEXT: Final[int]
WS_TAGS: Final[int]
WS_NONE: Final[int]
T_OPEN: Final[int]
T_CLOSE: Final[int]
T_SINGLE: Final[int]
PLACEHOLDER_START: Final[int]

class BaseFormatter:
    def __init__(self, normalize: int = 1, pretty_print: bool = False) -> None: ...
    def prepare(self, left_tree: _Element, right_tree: _Element) -> None: ...
    def format(self, diff: Iterable[_Action], orig_tree: _Element) -> str: ...

class PlaceholderEntry(NamedTuple):
    element: _Element
    ttype: int
    close_ph: str | None

class PlaceholderMaker:
    text_tags: Iterable[str]
    formatting_tags: Iterable[str]
    placeholder2tag: dict[str, PlaceholderEntry]
    tag2placeholder: dict[tuple[str, int, str | None], str]
    placeholder: int
    diff_tags: dict[str, tuple[str, str]]
    def __init__(self, text_tags: Iterable[str] = (), formatting_tags: Iterable[str] = ()) -> None: ...
    def get_placeholder(self, element: _Element, ttype: int, close_ph: str | None) -> str: ...
    def is_placeholder(self, char: str) -> bool: ...
    def is_formatting(self, element: _Element) -> bool: ...
    def do_element(self, element: _Element) -> None: ...
    def do_tree(self, tree: _Element) -> None: ...
    def split_string(self, text: str) -> list[str]: ...
    def undo_string(self, text: str) -> _Element: ...
    def undo_element(self, elem: _Element) -> None: ...
    def undo_tree(self, tree: _Element) -> None: ...
    def mark_diff(self, ph: str, action: str, attributes: Mapping[str, str] | None = None) -> str: ...
    def wrap_diff(self, text: str, action: str, attributes: Mapping[str, str] | None = None) -> str: ...

class XMLFormatter(BaseFormatter):
    normalize: int
    pretty_print: bool
    text_tags: Iterable[str]
    formatting_tags: Iterable[str]
    use_replace: bool
    placeholderer: PlaceholderMaker
    def __init__(
        self,
        normalize: int = 0,
        pretty_print: bool = True,
        text_tags: Iterable[str] = (),
        formatting_tags: Iterable[str] = (),
        use_replace: bool = False,
    ) -> None: ...
    def prepare(self, left_tree: _Element, right_tree: _Element) -> None: ...
    def finalize(self, result_tree: _Element) -> None: ...
    def format(self, diff: Iterable[_Action], orig_tree: _Element, differ: Differ | None = None) -> str: ...
    def render(self, result: _Element) -> str: ...
    def handle_action(self, action: _Action, result: _Element) -> None: ...

class DiffFormatter(BaseFormatter):
    normalize: int
    def __init__(self, normalize: int = 1, pretty_print: bool = False) -> None: ...
    def prepare(self, left: _Element, right: _Element) -> None: ...
    def finalize(self, left: _Element, right: _Element) -> None: ...
    def format(self, diff: Iterable[_Action], orig_tree: _Element) -> str: ...
    def handle_action(self, action: _Action) -> str: ...

class XmlDiffFormatter(BaseFormatter):
    normalize: int
    def __init__(self, normalize: int = 1, pretty_print: bool = False) -> None: ...
    def prepare(self, left: _Element, right: _Element) -> None: ...
    def finalize(self, left: _Element, right: _Element) -> None: ...
    def format(self, diff: Iterable[_Action], orig_tree: _Element) -> str: ...
    def handle_action(self, action: _Action, orig_tree: _Element) -> Generator[tuple[str, ...]]: ...
