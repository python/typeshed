from collections.abc import Generator, Iterable, Sequence
from typing import Any, Literal, TypeAlias

from xmldiff import actions

_Element: TypeAlias = Any  # lxml.etree._Element
_ElementTree: TypeAlias = Any  # lxml.etree._ElementTree

class Differ:
    F: float
    uniqueattrs: Iterable[str | Sequence[str]]
    fast_match: bool
    best_match: bool
    ignored_attrs: Iterable[str]
    def __init__(
        self,
        F: float | None = None,
        uniqueattrs: Iterable[str | Sequence[str]] | None = None,
        ratio_mode: Literal["accurate", "fast", "faster"] = "fast",
        fast_match: bool = False,
        best_match: bool = False,
        ignored_attrs: Iterable[str] = [],
    ) -> None: ...
    left: _Element | None
    right: _Element | None
    def clear(self) -> None: ...
    def set_trees(self, left: _Element | _ElementTree, right: _Element | _ElementTree) -> None: ...
    def append_match(self, lnode: _Element, rnode: _Element, max_match: float | None) -> None: ...
    def match(
        self, left: _Element | _ElementTree | None = None, right: _Element | _ElementTree | None = None
    ) -> list[tuple[_Element, _Element, float | None]]: ...
    def node_ratio(self, left: _Element, right: _Element) -> float: ...
    def node_text(self, node: _Element) -> str: ...
    def node_attribs(self, node: _Element) -> dict[str, str]: ...
    def leaf_ratio(self, left: _Element, right: _Element) -> float: ...
    def child_ratio(self, left: _Element, right: _Element) -> float | None: ...
    def update_node_tag(self, left: _Element, right: _Element) -> Generator[actions.RenameNode]: ...
    def update_node_attr(
        self, left: _Element, right: _Element
    ) -> Generator[actions.UpdateAttrib | actions.RenameAttrib | actions.InsertAttrib | actions.DeleteAttrib]: ...
    def update_node_text(self, left: _Element, right: _Element) -> Generator[actions.UpdateTextIn | actions.UpdateTextAfter]: ...
    def find_pos(self, node: _Element) -> int: ...
    def align_children(self, left: _Element, right: _Element) -> Generator[actions.MoveNode]: ...
    def diff(
        self, left: _Element | _ElementTree | None = None, right: _Element | _ElementTree | None = None
    ) -> Generator[actions._Action]: ...
