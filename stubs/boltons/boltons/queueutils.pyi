from collections.abc import Hashable
from typing import Any, Generic, TypeAlias, TypeVar, overload

_TaskT = TypeVar("_TaskT", bound=Hashable, default=Any)
_DefaultT = TypeVar("_DefaultT")

class BasePriorityQueue(Generic[_TaskT]):
    def __init__(self, **kw: Any) -> None: ...
    def add(self, task: _TaskT, priority: float | None = None) -> None: ...
    def remove(self, task: _TaskT) -> None: ...

    @overload
    def peek(self) -> _TaskT: ...
    @overload
    def peek(self, default: _DefaultT) -> _TaskT | _DefaultT: ...

    @overload
    def pop(self) -> _TaskT: ...
    @overload
    def pop(self, default: _DefaultT) -> _TaskT | _DefaultT: ...

    def __len__(self) -> int: ...

class HeapPriorityQueue(BasePriorityQueue[_TaskT]): ...
class SortedPriorityQueue(BasePriorityQueue[_TaskT]): ...

PriorityQueue: TypeAlias = SortedPriorityQueue[_TaskT]

__all__ = ["PriorityQueue", "BasePriorityQueue", "HeapPriorityQueue", "SortedPriorityQueue"]
