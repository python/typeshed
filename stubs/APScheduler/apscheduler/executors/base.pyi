from abc import ABCMeta, abstractmethod
from datetime import datetime

from apscheduler.events import JobExecutionEvent
from apscheduler.job import Job
from apscheduler.schedulers.base import BaseScheduler

class MaxInstancesReachedError(Exception):
    def __init__(self, job: Job) -> None: ...

class BaseExecutor(metaclass=ABCMeta):
    def __init__(self) -> None: ...
    def start(self, scheduler: BaseScheduler, alias: str) -> None: ...
    def shutdown(self, wait: bool = True) -> None: ...
    def submit_job(self, job: Job, run_times: list[datetime]) -> None: ...
    @abstractmethod
    def _do_submit_job(self, job: Job, run_times: list[datetime]) -> None: ...

def run_job(job: Job, jobstore_alias: str | None, run_times: list[datetime], logger_name: str) -> list[JobExecutionEvent]: ...
async def run_coroutine_job(
    job: Job, jobstore_alias: str | None, run_times: list[datetime], logger_name: str
) -> list[JobExecutionEvent]: ...
