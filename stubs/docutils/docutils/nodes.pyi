    def get(self, key: Literal["backrefs"], failobj: _T) -> list[str] | _T: ...
    @overload
    def get(self, key: _StrAttribute) -> str | None: ...
    @overload
    def get(self, key: _StrAttribute, failobj: _T) -> str | _T: ...
    @overload
    def get(self, key: _IntAttribute) -> int | None: ...
    @overload
    def get(self, key: _IntAttribute, failobj: _T) -> int | _T: ...
    @overload
    def get(self, key: str) -> Any: ...
    @overload
    def get(self, key: str, failobj: object) -> Any: ...

    def hasattr(self, attr: str) -> bool: ...
    def delattr(self, attr: str) -> None: ...

    @overload
    def setdefault(self, key: str) -> Any: ...
    @overload
    def setdefault(self, key: str, failobj: _T) -> Any | _T: ...

    has_key = hasattr
    def get_language_code(self, fallback: str = "") -> str: ...
    def append(self, item: Node) -> None: ...
    def extend(self, item: Iterable[Node]) -> None: ...
    def insert(self, index: SupportsIndex, item: Node | Iterable[Node] | None) -> None: ...
    def pop(self, i: int = -1) -> Node: ...
    def remove(self, item: Node) -> None: ...
    def index(self, item: Node, start: int = 0, stop: int = sys.maxsize) -> int: ...
    def previous_sibling(self) -> Node | None: ...
    def section_hierarchy(self) -> list[section]: ...
    def is_not_default(self, key: str) -> bool: ...
    def update_basic_atts(self, dict_: Mapping[str, object] | Node) -> None: ...
    def append_attr_list(self, attr: str, values: Iterable[object]) -> None: ...
    def coerce_append_attr_list(self, attr: str, value: object) -> None: ...
    def replace_attr(self, attr: str, value: object, force: bool = True) -> None: ...
    def copy_attr_convert(self, attr: str, value: object, replace: bool = True) -> None: ...
    def copy_attr_coerce(self, attr: str, value: object, replace: bool) -> None: ...
    def copy_attr_concatenate(self, attr: str, value: object, replace: bool) -> None: ...
    def copy_attr_consistent(self, attr: str, value: object, replace: bool) -> None: ...
    def update_all_atts(
        self,
        dict_: Mapping[str, object] | Node,
        update_fun: Callable[[Element, str, Any, bool], object] = ...,  # an unbound `Element.copy_attr_*` method
        replace: bool = True,
        and_source: bool = False,
    ) -> None: ...
    def update_all_atts_consistantly(
        self, dict_: Mapping[str, object] | Node, replace: bool = True, and_source: bool = False
    ) -> None: ...
    def update_all_atts_concatenating(
        self, dict_: Mapping[str, object] | Node, replace: bool = True, and_source: bool = False
    ) -> None: ...
    def update_all_atts_coercion(
        self, dict_: Mapping[str, object] | Node, replace: bool = True, and_source: bool = False
    ) -> None: ...
    def update_all_atts_convert(self, dict_: Mapping[str, object] | Node, and_source: bool = False) -> None: ...
    def clear(self) -> None: ...
    def replace(self, old: Node, new: Node | Sequence[Node]) -> None: ...
    def replace_self(self, new: Node | Sequence[Node]) -> None: ...
    def first_child_matching_class(
        self, childclass: type[Node] | tuple[type[Node], ...], start: int = 0, end: int = sys.maxsize
    ) -> int | None: ...
    def first_child_not_matching_class(
        self, childclass: type[Node] | tuple[type[Node], ...], start: int = 0, end: int = sys.maxsize
    ) -> int | None: ...
    def pformat(self, indent: str = "    ", level: int = 0) -> str: ...
    def copy(self) -> Self: ...
    def deepcopy(self) -> Self: ...
    def note_referenced_by(self, name: str | None = None, id: str | None = None) -> None: ...
    @classmethod
    def is_not_list_attribute(cls, attr: str) -> bool: ...
    @classmethod
    def is_not_known_attribute(cls, attr: str) -> bool: ...
    def validate_attributes(self) -> None: ...
    def validate_content(self, model: _ContentModelTuple | None = None, elements: Sequence[Node] | None = None) -> list[Node]: ...

    # '__iter__' is added as workaround, since mypy doesn't support classes that are iterable via '__getitem__'
    # see https://github.com/python/typeshed/pull/10099#issuecomment-1528789395
    @type_check_only
    def __iter__(self) -> Iterator[Node]: ...

