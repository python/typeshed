# The parts of `commonmark.node.Node` used by `recommonmark` (neither package ships type hints).
@type_check_only
class _MarkdownNode(Protocol):
    t: str
    parent: _MarkdownNode | None
    first_child: _MarkdownNode | None
    last_child: _MarkdownNode | None
    sourcepos: Sequence[Sequence[int]] | None
    literal: str | None
    list_data: dict[str, Any]  # heterogeneous list properties ("type", "start", "delimiter", ...)
    info: str | None
    destination: str | None
    title: str | None
    level: int | None
    is_fenced: bool
    def is_container(self) -> bool: ...

