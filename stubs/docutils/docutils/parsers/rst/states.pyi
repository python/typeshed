    def underline(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...
    def short_overline(self, context: _Context, blocktext: str, lineno: int, lines: int = 1) -> None: ...
    def state_correction(self, context: _Context, lines: int = 1) -> Never: ...

class QuotedLiteralBlock(RSTState):
