    def field_marker(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...

class OptionList(SpecializedBody):
    blank_finish: bool
    def option_marker(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...

class RFC2822List(SpecializedBody, RFC2822Body):
    patterns: ClassVar[dict[str, str | Pattern[str]]]
    initial_transitions: ClassVar[list[tuple[str, str]]]
    blank_finish: bool
    def rfc2822(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...
    blank = SpecializedBody.invalid_input

class ExtensionOptions(FieldList):
    def parse_field_body(self, indented: StringList, offset: int, node: nodes.Element) -> None: ...

class LineBlock(SpecializedBody):
