    # See the comment in SpecializedBody.
    def invalid_input(
        self, match: Match[str] | None = None, context: _Context | None = None, next_state: str | None = None
    ) -> Never: ...
    @type_check_only
    def blank(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...
    @type_check_only
    def indent(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...
    @type_check_only
    def underline(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...
    @type_check_only
    def text(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...

class Definition(SpecializedText):
    blank_finish: bool
    def eof(self, context: _Context) -> list[str]: ...
    def indent(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...

class Line(SpecializedText):
    eofcheck: int
    def eof(self, context: _Context) -> list[str]: ...
    def blank(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...
    def text(self, match: Match[str], context: _Context, next_state: str) -> _TransitionResult: ...
