from collections.abc import Callable, Generator, Mapping
from typing import ClassVar, Final, Protocol, TextIO, TypeVar, type_check_only
from typing_extensions import Self

_T = TypeVar("_T")
_ContainerT = TypeVar("_ContainerT", bound=Container)
_FormulaBitT = TypeVar("_FormulaBitT", bound=FormulaBit)

# The line reader expected by the (unused) eLyXer parsers; there is no implementation in docutils.
@type_check_only
class _LineReader(Protocol):
    linenumber: int
    def currentline(self) -> str: ...
    def nextline(self) -> None: ...

__docformat__: Final = "reStructuredText"
__version__: Final[str]

