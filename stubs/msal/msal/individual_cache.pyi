from _typeshed import Incomplete
from collections.abc import Iterator, MutableMapping

class _ExpiringMapping(MutableMapping[Incomplete, Incomplete]):
    def __init__(self, mapping=None, capacity=None, expires_in=None, lock=None, *args, **kwargs) -> None: ...
    def set(self, key, value, expires_in) -> None: ...
    def __setitem__(self, key, value) -> None: ...
    def __getitem__(self, key): ...
    def __delitem__(self, key) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Incomplete]: ...

class _IndividualCache:
    def __init__(self, mapping=None, key_maker=None, expires_in=None) -> None: ...
    def __call__(self, function): ...
