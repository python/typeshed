from _typeshed import Incomplete
from collections.abc import MutableMapping
from typing import Any

from .oauth2cli.http import Response

DEVICE_AUTH_GRANT: str

class RetryAfterParser:
    FIELD_NAME_LOWER: str
    def __init__(self, default_value: int | None = None) -> None: ...
    def parse(self, *, result, **ignored) -> int: ...

class NormalizedResponse(Response):
    def __init__(self, raw_response) -> None: ...
    def raise_for_status(self) -> None: ...

class ThrottledHttpClientBase:
    http_client: Incomplete
    def __init__(self, http_client, *, http_cache: MutableMapping[str, Any] | None = None) -> None: ...
    def post(self, *args, **kwargs) -> NormalizedResponse: ...
    def get(self, *args, **kwargs) -> NormalizedResponse: ...
    def close(self): ...

class ThrottledHttpClient(ThrottledHttpClientBase):
    def __init__(self, *args, default_throttle_time: int | None = None, **kwargs) -> None: ...
