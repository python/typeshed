from collections.abc import Callable, Sequence
from typing import Final, TypeVar

_T = TypeVar("_T")

ALL_REMAINING: Final[int]  # undocumented

def Setup(
    args: Sequence[str],
    test_one_input: Callable[[bytes], None],
    /,
    **kwargs: bool | Callable[[bytes, int, int], str | bytes] | Callable[[bytes, bytes, int, int], str | bytes] | None,
) -> list[str]: ...
def Fuzz() -> None: ...
def Mutate(data: bytes, max_size: int, /) -> bytes: ...

class FuzzedDataProvider:
    def __init__(self, data: bytes, /) -> None: ...
    def ConsumeUnicode(self, count: int) -> str: ...
    def ConsumeUnicodeNoSurrogates(self, count: int, /) -> str: ...
    def ConsumeBytes(self, count: int, /) -> bytes: ...
    def ConsumeString(self, count: int, /) -> str: ...
    def ConsumeInt(self, byte_size: int, /) -> int: ...
    def ConsumeUInt(self, byte_size: int, /) -> int: ...
    def ConsumeIntInRange(self, min: int, max: int, /) -> int: ...
    def ConsumeIntList(self, count: int, byte_size: int, /) -> list[int]: ...
    def ConsumeIntListInRange(self, count: int, min: int, max: int, /) -> list[int]: ...
    def ConsumeFloat(self) -> float: ...
    def ConsumeRegularFloat(self) -> float: ...
    def ConsumeProbability(self) -> float: ...
    def ConsumeFloatInRange(self, min: float, max: float, /) -> float: ...
    def ConsumeFloatList(self, count: int, /) -> list[float]: ...
    def ConsumeRegularFloatList(self, count: int, /) -> list[float]: ...
    def ConsumeProbabilityList(self, count: int, /) -> list[float]: ...
    def ConsumeFloatListInRange(self, count: int, min: float, max: float, /) -> list[float]: ...
    def PickValueInList(self, values: list[_T], /) -> _T: ...
    def ConsumeBool(self) -> bool: ...
    def remaining_bytes(self) -> int: ...  # undocumented
    def buffer(self) -> bytes: ...  # undocumented
