from datetime import date, datetime, time
from typing import TypeAlias

from .._common import _ReadAll
from ..tz import tzoffset, tzutc

_Readable: TypeAlias = _ReadAll[str | bytes]
_TakesAscii: TypeAlias = str | bytes | _Readable

__all__ = ["isoparse", "isoparser"]

class isoparser:
    def __init__(self, sep: str | None = None) -> None: ...
    def isoparse(self, dt_str: _TakesAscii) -> datetime: ...
    def parse_isodate(self, datestr: _TakesAscii) -> date: ...
    def parse_isotime(self, timestr: _TakesAscii) -> time: ...
    def parse_tzstr(self, tzstr: _TakesAscii, zero_as_utc: bool = True) -> tzutc | tzoffset: ...

def isoparse(dt_str: _TakesAscii) -> datetime: ...
