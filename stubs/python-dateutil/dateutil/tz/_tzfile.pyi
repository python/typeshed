from _typeshed import SupportsRead, Unused
from collections.abc import Callable, Sequence
from datetime import datetime, timedelta
from typing import ClassVar, TypeAlias

from ._common import _tzinfo

_TZifData: TypeAlias = tuple[Sequence[int], Sequence[int], Sequence[int], Sequence[int], Sequence[str], bytes | None]
_PickleArgs: TypeAlias = tuple[type[tzfile], str | None, object, _TZifData]
_Reduction: TypeAlias = tuple[Callable[..., tzfile], _PickleArgs] | tuple[Callable[..., tzfile], _PickleArgs, dict[str, object]]

EPOCH: datetime
EPOCHORDINAL: int

class tzfile(_tzinfo):
    def __init__(
        self, fileobj: str | SupportsRead[bytes] | None, filename: str | None = None, key: str | None = None
    ) -> None: ...
    @property
    def key(self) -> str | None: ...
    def is_ambiguous(self, dt: datetime | None) -> bool: ...
    def utcoffset(self, dt: datetime | None) -> timedelta | None: ...
    def dst(self, dt: datetime | None) -> timedelta | None: ...
    def tzname(self, dt: datetime | None) -> str | None: ...
    def __eq__(self, other: object) -> bool: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]
    def __ne__(self, other: object) -> bool: ...
    def __reduce__(self) -> _Reduction: ...
    def __reduce_ex__(self, protocol: Unused) -> _Reduction: ...

def load_data(fobj: SupportsRead[bytes]) -> _TZifData: ...
