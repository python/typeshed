import sys
from _typeshed import SupportsRAdd
from datetime import datetime, timedelta, tzinfo
from typing import ClassVar, Literal, TypeVar, type_check_only

from .._common import _ReadAll, _TotalSeconds
from ._common import _tzinfo, enfold as enfold, tzrangebase
from ._tzfile import tzfile as tzfile

if sys.platform == "win32":
    from .win import tzwin as tzwin, tzwinlocal as tzwinlocal
else:
    tzwin: None
    tzwinlocal: None

_DateTimeT = TypeVar("_DateTimeT", bound=datetime)

ZERO: timedelta
EPOCH: datetime

class tzutc(tzinfo):
    def utcoffset(self, dt: object) -> timedelta: ...
    def dst(self, dt: object) -> timedelta: ...
    def tzname(self, dt: object) -> str: ...
    def is_ambiguous(self, dt: object) -> bool: ...
    def fromutc(self, dt: _DateTimeT) -> _DateTimeT: ...
    def __eq__(self, other: object) -> bool: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]
    def __ne__(self, other: object) -> bool: ...
    __reduce__ = object.__reduce__

UTC: tzutc

class tzoffset(tzinfo):
    def __init__(self, name: str | None, offset: float | _TotalSeconds) -> None: ...
    def utcoffset(self, dt: object) -> timedelta: ...
    def dst(self, dt: object) -> timedelta: ...
    def is_ambiguous(self, dt: object) -> bool: ...
    def tzname(self, dt: object) -> str | None: ...
    def fromutc(self, dt: _DateTimeT) -> _DateTimeT: ...
    def __eq__(self, other: object) -> bool: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]
    def __ne__(self, other: object) -> bool: ...
    __reduce__ = object.__reduce__
    @classmethod
    def instance(cls, name: str | None, offset: float | _TotalSeconds) -> tzoffset: ...

class tzlocal(_tzinfo):
    def __init__(self) -> None: ...
    def utcoffset(self, dt: datetime | None) -> timedelta | None: ...
    def dst(self, dt: datetime | None) -> timedelta | None: ...
    def tzname(self, dt: datetime | None) -> str: ...
    def is_ambiguous(self, dt: datetime | None) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]
    def __ne__(self, other: object) -> bool: ...
    __reduce__ = object.__reduce__

class tzrange(tzrangebase):
    hasdst: bool
    def __init__(
        self,
        stdabbr: str | None,
        stdoffset: float | _TotalSeconds | None = None,
        dstabbr: str | None = None,
        dstoffset: float | _TotalSeconds | None = None,
        start: timedelta | SupportsRAdd[datetime, datetime] | Literal[False] | None = None,
        end: timedelta | SupportsRAdd[datetime, datetime] | Literal[False] | None = None,
    ) -> None: ...
    def transitions(self, year: int) -> tuple[datetime, datetime] | None: ...
    def __eq__(self, other: object) -> bool: ...

class tzstr(tzrange):
    hasdst: bool
    def __init__(self, s: str, posix_offset: bool = False) -> None: ...
    @classmethod
    def instance(cls, s: str, posix_offset: bool = False) -> tzstr: ...

class tzical:
    def __init__(self, fileobj: str | _ReadAll[str]) -> None: ...
    def keys(self) -> list[str]: ...
    def get(self, tzid: str | None = None) -> tzinfo | None: ...

TZFILES: list[str]

def datetime_exists(dt: datetime, tz: tzinfo | None = None) -> bool: ...
def datetime_ambiguous(dt: datetime, tz: tzinfo | None = None) -> bool: ...
def resolve_imaginary(dt: _DateTimeT) -> _DateTimeT: ...

# Singleton type defined locally in a function. Calls itself "GettzFunc".
@type_check_only
class _GetTZ:
    def __call__(self, name: str | None = None) -> tzinfo | None: ...
    def set_cache_size(self, size: int) -> None: ...
    def cache_clear(self) -> None: ...
    def nocache(self, name: str | None = None) -> tzinfo | None: ...

gettz: _GetTZ

class DeprecatedTzKeyWarning(FutureWarning): ...

def available_iana_timezones() -> set[str]: ...
