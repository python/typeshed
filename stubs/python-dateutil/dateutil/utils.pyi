from _typeshed import SupportsSub
from datetime import _TzInfo, date, datetime, timedelta
from typing import Protocol, TypeVar, overload, type_check_only
from typing_extensions import Self

@type_check_only
class _WithTimezone(Protocol):
    @property
    def tzinfo(self) -> _TzInfo | None: ...
    def replace(self, *, tzinfo: _TzInfo | None) -> Self: ...

@type_check_only
class _Delta(Protocol):
    def __abs__(self) -> Self: ...
    def __neg__(self) -> Self: ...
    def __le__(self, other: Self, /) -> bool: ...

_WithTimezoneT = TypeVar("_WithTimezoneT", bound=_WithTimezone)
_DeltaT = TypeVar("_DeltaT", bound=_Delta)
_OperandT = TypeVar("_OperandT")

def today(tzinfo: _TzInfo | None = None) -> datetime: ...
def default_tzinfo(dt: _WithTimezoneT, tzinfo: _TzInfo | None) -> _WithTimezoneT: ...

@overload
def within_delta(dt1: date, dt2: date, delta: timedelta) -> bool: ...
@overload
def within_delta(dt1: SupportsSub[_OperandT, _DeltaT], dt2: _OperandT, delta: _DeltaT) -> bool: ...
