from _typeshed import FloatInt
class ProgressCalculator:
    SAMPLING_WINDOW: int
    SAMPLING_RATE: FloatInt
    GRACE_PERIOD: int
    downloaded: int
    elapsed: FloatInt
    speed: SmoothValue
    eta: SmoothValue
    def __init__(self, initial: int) -> None: ...

    @property
    def total(self) -> int | None: ...
    @total.setter
    def total(self, value: int | None) -> None: ...

    def thread_reset(self) -> None: ...
    def update(self, size: int | None) -> None: ...

class SmoothValue:
    value: FloatInt | None
    def __init__(self, initial: FloatInt | None, smoothing: FloatInt) -> None: ...
    smooth: FloatInt | None
    def set(self, value: FloatInt) -> None: ...
    def reset(self) -> None: ...
